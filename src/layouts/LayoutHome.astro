---
import Navbar from '../components/Navbar.astro';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	imagePath?: string;
	twitterHandle?: string;
}

const {
  title,
  description = "Daffa Raihan is a full‑stack developer building scalable systems and AI-powered products. End-to-end experience from system design and CI/CD automation to production-ready web and backend services.",
  keywords = "daffa raihan, daffaraihan, daffa raihan portfolio, daffa raihan uii, universitas islam indonesia, uii informatics, full stack developer, full stack engineer, software engineer, backend engineer, nestjs, golang, next.js, postgresql, ci/cd, system design, indes 2025, automata 2025, xai, explainable ai",
  imagePath = "/logo.png",
  twitterHandle,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname + Astro.url.search, Astro.site).href
  : Astro.url.href;
const ogImageURL = new URL(imagePath, (Astro.site ?? Astro.url.origin)).href;
const sameAs = [
  "https://instagram.com/dffar.hn",
  "https://github.com/Dffarhn",
  "https://linkedin.com/in/dapdap",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${canonicalURL}#person`,
      name: "Daffa Raihan",
      alternateName: ["Muhammad Daffa Raihan", "Daffaraihan"],
      url: canonicalURL,
      image: ogImageURL,
      jobTitle: "Full-stack Developer",
      alumniOf: [
        {
          "@type": "CollegeOrUniversity",
          name: "Universitas Islam Indonesia",
          alternateName: "UII",
        },
      ],
      sameAs,
      knowsAbout: [
        "Full-stack development",
        "Backend engineering",
        "System design",
        "CI/CD",
        "NestJS",
        "Golang",
        "Next.js",
        "PostgreSQL",
        "Supabase",
        "Firebase",
        "Explainable AI (XAI)",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalURL}#website`,
      name: "Daffa Raihan",
      url: canonicalURL,
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      isPartOf: { "@id": `${canonicalURL}#website` },
      about: { "@id": `${canonicalURL}#person` },
      inLanguage: "en",
    },
  ],
};
const navLinks = [
  { href: '/', text: 'Home' },
  { href: '/tasks', text: 'Tasks' },
  { href: '/about', text: 'About' },
  { href: '/auth/login', text: 'Login' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content={description} />
	<meta name="keywords" content={keywords} />
	<meta name="author" content="Daffa Raihan" />
	<meta name="theme-color" content="#13151a" />
	<link rel="canonical" href={canonicalURL} />

	<link rel="icon" type="image/png" href="/logo.png" />
	<link rel="apple-touch-icon" href="/logo.png" />

	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={ogImageURL} />
	<meta property="og:image:alt" content="Daffa Raihan  Full-stack Developer portfolio" />
	<meta property="og:url" content={canonicalURL} />
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="Daffa Raihan" />
	<meta property="og:locale" content="en_US" />

	<meta property="twitter:card" content="summary_large_image" />
	<meta property="twitter:title" content={title} />
	<meta property="twitter:description" content={description} />
	<meta property="twitter:image" content={ogImageURL} />
	<meta property="twitter:image:alt" content="Daffa Raihan  Full-stack Developer portfolio" />
	<meta property="twitter:url" content={canonicalURL} />
	<meta property="twitter:domain" content="daffaraihan.vercel.app" />
	{twitterHandle ? (
		<>
			<meta property="twitter:site" content={twitterHandle} />
			<meta property="twitter:creator" content={twitterHandle} />
		</>
	) : null}
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <title>{title} | Daffa Raihan</title>
  <link rel="stylesheet" href="../styles/global.css">
</head>
<body>
  <div class="container">
	<Navbar links={navLinks} />
	<slot />
  </div>
</body>
</html>
<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	html {
		font-family: system-ui, sans-serif;
		background: #13151a;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	body{
		margin: 0;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.container{
		width: 100%;
		max-width: 1500px;
		padding: 1rem;
	}

	main {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    padding: 0;
	  color: white;
  }

	
</style>
