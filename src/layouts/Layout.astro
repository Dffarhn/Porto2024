---
import "@/styles/globals.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  imagePath?: string;
  twitterHandle?: string;
}

const {
  title,
  description = "Daffa Raihan is a full‑stack developer building scalable systems and AI-powered products. End-to-end experience from system design and CI/CD automation to production-ready web and backend services.",
  keywords = "daffa raihan, daffaraihan, daffa raihan portfolio, daffa raihan uii, universitas islam indonesia, uii informatics, full stack developer, full stack engineer, software engineer, backend engineer, nestjs, golang, next.js, postgresql, mysql, supabase, firebase, ci/cd, system design, indes 2025, automata 2025, xai, explainable ai",
  imagePath = "/logo.png",
  twitterHandle,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname + Astro.url.search, Astro.site).href
  : Astro.url.href;
const ogImageURL = new URL(imagePath, (Astro.site ?? Astro.url.origin)).href;

const sameAs = [
  "https://instagram.com/dffar.hn",
  "https://github.com/Dffarhn",
  "https://linkedin.com/in/dapdap",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${canonicalURL}#person`,
      name: "Daffa Raihan",
      alternateName: ["Muhammad Daffa Raihan", "Daffaraihan"],
      url: canonicalURL,
      image: ogImageURL,
      jobTitle: "Full-stack Developer",
      alumniOf: [
        {
          "@type": "CollegeOrUniversity",
          name: "Universitas Islam Indonesia",
          alternateName: "UII",
        },
      ],
      sameAs,
      knowsAbout: [
        "Full-stack development",
        "Backend engineering",
        "System design",
        "CI/CD",
        "NestJS",
        "Golang",
        "Next.js",
        "PostgreSQL",
        "Supabase",
        "Firebase",
        "Explainable AI (XAI)",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalURL}#website`,
      name: "Daffa Raihan",
      url: canonicalURL,
      inLanguage: "en",
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      isPartOf: { "@id": `${canonicalURL}#website` },
      about: { "@id": `${canonicalURL}#person` },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const theme = saved === "light" || saved === "dark"
          ? saved
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        const syncThemeColor = () => document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#11120f" : "#f2f0e8");
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", syncThemeColor, { once: true });
        } else {
          syncThemeColor();
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Daffa Raihan" />
    <meta name="theme-color" content="#f2f0e8" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Daffa Raihan  Full-stack Developer portfolio" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daffa Raihan" />
    <meta property="og:locale" content="en_US" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:image:alt" content="Daffa Raihan  Full-stack Developer portfolio" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:domain" content="daffaraihan.vercel.app" />
    {twitterHandle ? (
      <>
        <meta property="twitter:site" content={twitterHandle} />
        <meta property="twitter:creator" content={twitterHandle} />
      </>
    ) : null}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <title>{title} | Daffa Raihan</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --primary: 49, 87, 255;
    --primary-dark: 35, 65, 201;
    --secondary: 90, 92, 84;
    --accent: 49, 87, 255;
    --success: 34, 197, 94;
    --warning: 234, 179, 8;
    --error: 239, 68, 68;
    --background: 242, 240, 232;
    --background-light: 250, 249, 244;
    --background-lighter: 255, 255, 255;
    --text: 22, 23, 19;
    --text-muted: 90, 92, 84;
    --text-dark: 131, 132, 123;
    --border: 190, 189, 178;
    --ink: #161713;
    --paper: #f2f0e8;
    --paper-light: #faf9f4;
    --signal: #3157ff;
    --signal-surface: #3157ff;
    --acid: #dfff4f;
    --dark-surface: #161713;
    --on-dark: #f2f0e8;
    --on-dark-muted: #b6b5ad;
    --on-acid: #161713;
    --accent-on-acid: #203eb8;
    --radius: 6px;
    --radius-lg: 14px;
    --font-sans: "Bricolage Grotesque", system-ui, sans-serif;
    --font-mono: "DM Mono", ui-monospace, monospace;

    --gradient-primary: rgb(var(--primary));
    --gradient-secondary: rgb(var(--secondary));
    --gradient-card: rgb(var(--background-light));
    --gradient-hover: transparent;
    --gradient-border: rgba(22, 23, 19, 0.12);

    --shadow-sm: none;
    --shadow-md: none;
    --shadow-lg: none;
    --shadow-xl: none;

    --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 280ms cubic-bezier(0.4, 0, 0.2, 1);
    --bounce: cubic-bezier(0.4, 0, 0.2, 1);
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    --primary: 125, 152, 255;
    --primary-dark: 154, 174, 255;
    --secondary: 171, 173, 163;
    --accent: 125, 152, 255;
    --background: 17, 18, 15;
    --background-light: 24, 25, 21;
    --background-lighter: 31, 32, 27;
    --text: 242, 240, 232;
    --text-muted: 171, 173, 163;
    --text-dark: 118, 120, 111;
    --border: 74, 76, 68;
    --ink: #f2f0e8;
    --paper: #11120f;
    --paper-light: #181915;
    --signal: #7d98ff;
    --signal-surface: #3157ff;
    --acid: #dfff4f;
    --dark-surface: #161713;
    --on-dark: #f2f0e8;
    --on-dark-muted: #b6b5ad;
    --on-acid: #161713;
    --accent-on-acid: #203eb8;
    --gradient-border: rgba(242, 240, 232, 0.14);
    color-scheme: dark;
  }
  
  html {
    font-family: var(--font-sans);
    background: rgb(var(--background));
    scroll-behavior: smooth;
    color: rgb(var(--text));
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.04;
    margin: 0 0 1rem;
    color: rgb(var(--text));
  }

  h1 { font-size: 4rem; }
  h2 { font-size: 3rem; }
  h3 { font-size: 2rem; }
  h4 { font-size: 1.5rem; }
  h5 { font-size: 1.25rem; }
  h6 { font-size: 1rem; }
  
  code {
    font-family: var(--font-mono);
    background: rgb(var(--background-light));
    padding: 0.15em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
    border: 1px solid rgba(var(--border), 0.6);
  }
  
  /* Enhanced Layout */
  body {
    margin: 0;
    min-height: 100vh;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    background:
      linear-gradient(rgba(var(--text), 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--text), 0.035) 1px, transparent 1px),
      rgb(var(--background));
    background-size: 64px 64px;
  }
  
  .container {
    width: 100%;
    max-width: none;
    margin: 0 auto;
    padding: 0;
  }
  
  /* Enhanced Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  
  ::-webkit-scrollbar-track {
    background: rgb(var(--background));
  }
  
  ::-webkit-scrollbar-thumb {
    background: rgb(var(--text));
    border: 3px solid rgb(var(--background));
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: rgb(var(--text-muted));
  }
  
  a {
    color: rgb(var(--text));
    text-decoration: none;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  a:hover {
    color: rgb(var(--primary));
    opacity: 1;
  }

  button {
    transition: opacity var(--transition-normal);
    cursor: pointer;
  }
  
  .glass {
    background: rgba(var(--background-light), 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(var(--border), 0.5);
    border-radius: var(--radius);
  }

  .card {
    background: rgb(var(--background-light));
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    border: 1px solid rgba(var(--border), 0.8);
  }

  /* Enhanced Selection */
  ::selection {
    background: rgba(var(--primary), 0.3);
    color: rgb(var(--text));
  }

  /* Enhanced Focus Styles */
  :focus {
    outline: 2px solid rgb(var(--primary));
    outline-offset: 2px;
  }

  :focus:not(:focus-visible) {
    outline: none;
  }

  /* Enhanced Animation Classes */
  .fade-in {
    animation: fadeIn var(--transition-normal);
  }

  .slide-up {
    animation: slideUp var(--transition-normal);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { 
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Enhanced Media Queries */
  @media (max-width: 768px) {
    html { font-size: 15px; }
    .container { padding: 0; }
    h1 { font-size: 2.75rem; }
    h2 { font-size: 2rem; }
    h3 { font-size: 1.75rem; }
  }

  @media (max-width: 480px) {
    html { font-size: 14px; }
    .container { padding: 0; }
    h1 { font-size: 2.4rem; }
    h2 { font-size: 1.75rem; }
    h3 { font-size: 1.5rem; }
  }

  /* Enhanced Print Styles */
  @media print {
    body {
      background: white;
      color: black;
    }
    .container {
      width: 100%;
      max-width: none;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
