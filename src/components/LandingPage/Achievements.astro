---
const achievements = [
  { year: "2026", title: "Research Assistant Scholarship", event: "M.Kom. Informatics · UII", note: "Fully funded" },
  { year: "2026", title: "Gold Pin Award", event: "Top Graduate", note: "Highest undergraduate distinction" },
  { year: "2025", title: "Silver Medal", event: "INDES · Malaysia", note: "HalalMate" },
  { year: "2025", title: "Best Paper", event: "Automata", note: "XAI-based halal detection" },
];
---

<div class="awards-section">
  <div class="awards-inner">
    <header>
      <p class="section-index">05 / Recognition</p>
      <h2>Work recognized<br />beyond the <em>screen.</em></h2>
    </header>

    <ol class="awards-list">
      {achievements.map((award, index) => (
        <li>
          <span class="award-index">A{index + 1}</span>
          <div>
            <p class="award-event">{award.event}</p>
            <h3>{award.title}</h3>
          </div>
          <p class="award-note">{award.note}</p>
          <span class="award-year">{award.year}</span>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .awards-section {
    padding: clamp(5rem, 10vw, 9rem) 1.5rem;
    background: var(--signal-surface);
    color: white;
  }

  .awards-inner {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .section-index {
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #e0e5ff;
  }

  h2 {
    position: sticky;
    top: 7rem;
    margin: 0;
    max-width: 11ch;
    color: white;
    font-size: clamp(3rem, 5.8vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.92;
  }

  h2 em {
    color: var(--acid);
    font-weight: 400;
  }

  .awards-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.55);
  }

  .awards-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr minmax(130px, 0.55fr) auto;
    gap: 1rem;
    align-items: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.55);
    transition: padding 180ms ease, background 180ms ease;
  }

  .awards-list li:hover {
    padding-inline: 0.75rem;
    background: rgba(255, 255, 255, 0.1);
  }

  .award-index,
  .award-year,
  .award-event {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    text-transform: uppercase;
    color: #e0e5ff;
  }

  .award-event { margin: 0 0 0.45rem; }
  .award-year { text-align: right; }

  h3 {
    margin: 0;
    color: white;
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .award-note {
    margin: 0;
    color: #edf0ff;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .awards-inner { grid-template-columns: 1fr; }
    h2 { position: static; }
  }

  @media (max-width: 620px) {
    .awards-section { padding-inline: 1rem; }
    .awards-list li { grid-template-columns: 2rem 1fr auto; }
    .award-note { grid-column: 2 / -1; }
  }
</style>
