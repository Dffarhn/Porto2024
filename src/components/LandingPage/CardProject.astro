---
import { featuredProjects, seriesProjects } from "@/data/projects";

const series = seriesProjects[0];
const coffeeSites = series?.coffeeSites ?? [];
const previewSites = coffeeSites.slice(0, 3);
---

<div class="work-section">
  <div class="work-inner">
    <header class="work-heading">
      <p class="section-index">02 / Selected work</p>
      <div>
        <h2>Built for the <em>real world.</em></h2>
        <p>Production platforms, automation systems, and applied AI with measurable outcomes.</p>
      </div>
    </header>

    <div class="project-list">
      {featuredProjects.map((project, index) => (
        <article class="project" style={`--project-accent: rgb(${project.accent})`}>
          <a class="project-media" href={`/projects/${project.slug}`} aria-label={`Read ${project.title} case study`}>
            {project.img ? (
              <img src={project.img} alt={`Preview of ${project.title}`} loading={index > 1 ? "lazy" : "eager"} />
            ) : (
              <div class="project-placeholder">{project.initials}</div>
            )}
            <span class="open-mark">View case ↗</span>
          </a>

          <div class="project-copy">
            <div class="project-meta">
              <span>0{index + 1}</span>
              <span>{project.client ?? project.role}</span>
            </div>
            <h3><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
            <p class="project-subtitle">{project.subtitle}</p>
            <p class="project-description">{project.shortDescription}</p>
            {project.impact && <p class="project-impact">{project.impact}</p>}
            {project.techStack.length > 0 && (
              <ul class="project-stack">
                {project.techStack.slice(0, 4).map((item) => <li>{item}</li>)}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  {series && (
    <div class="coffee-section" id="one-coffee-one-web">
      <div class="coffee-inner">
        <header class="coffee-heading">
          <p class="section-index">03 / Creative playground</p>
          <div>
            <p class="coffee-count">{coffeeSites.length} places · {coffeeSites.length} visual languages</p>
            <h2>One coffee.<br /><em>One website.</em></h2>
          </div>
          <p class="coffee-copy">{series.shortDescription}</p>
        </header>

        <a class="coffee-gallery" href={`/projects/${series.slug}`} aria-label="Explore the One Coffee One Web series">
          {previewSites.map((site, index) => (
            <figure class={`coffee-tile tile-${index + 1}`}>
              {site.img && <img src={site.img} alt={`Website design for ${site.name}`} loading="lazy" />}
              <figcaption><span>{site.number}</span>{site.name}</figcaption>
            </figure>
          ))}
        </a>

        <a class="series-link" href={`/projects/${series.slug}`}>Explore the complete series <span>↗</span></a>
      </div>
    </div>
  )}
</div>

<style>
  .work-section {
    background: var(--paper);
  }

  .work-inner,
  .coffee-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: clamp(5rem, 10vw, 9rem) 1.5rem;
  }

  .work-heading,
  .coffee-heading {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) 1.1fr 0.55fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }

  .section-index,
  .coffee-count {
    margin: 0;
    align-self: start;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  .work-heading h2,
  .coffee-heading h2 {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(3.1rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  h2 em {
    color: var(--signal);
    font-weight: 400;
  }

  .work-heading > div > p {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: rgb(var(--text-muted));
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .project-list {
    border-top: 1px solid var(--ink);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(3rem, 7vw, 6rem) 0;
    border-bottom: 1px solid var(--ink);
    align-items: center;
  }

  .project:nth-child(even) .project-media {
    order: 2;
  }

  .project-media {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    background: var(--project-accent);
    color: white;
  }

  .project-media::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgba(var(--text), 0.12);
    pointer-events: none;
  }

  .project-media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    display: block;
    object-fit: cover;
    object-position: top center;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-media:hover img {
    transform: scale(1.025);
  }

  .project-placeholder {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 700;
  }

  .open-mark {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.65rem 0.9rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    transform: translateY(8px);
    opacity: 0;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .project-media:hover .open-mark {
    transform: translateY(0);
    opacity: 1;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(var(--text), 0.3);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  .project-copy h3 {
    margin: 1.5rem 0 0.25rem;
    font-size: clamp(2.4rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
  }

  .project-copy h3 a {
    color: var(--ink);
  }

  .project-copy h3 a:hover {
    color: var(--signal);
  }

  .project-subtitle {
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  .project-description {
    margin: 0 0 1.25rem;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.55;
  }

  .project-impact {
    margin: 0 0 1.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--signal);
    color: rgb(var(--text-muted));
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-stack li {
    padding: 0.45rem 0.65rem;
    border: 1px solid rgba(var(--text), 0.35);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .coffee-section {
    background: var(--acid);
    color: var(--on-acid);
  }

  .coffee-heading {
    align-items: start;
  }

  .coffee-heading h2 em {
    color: var(--accent-on-acid);
  }

  .coffee-heading h2 {
    color: var(--on-acid);
  }

  .coffee-count {
    margin-bottom: 1rem;
    color: rgba(22, 23, 19, 0.65);
  }

  .coffee-copy {
    margin: 0;
    align-self: end;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(22, 23, 19, 0.7);
  }

  .coffee-gallery {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1rem;
    color: var(--on-acid);
  }

  .coffee-tile {
    grid-column: span 4;
    margin: 0;
  }

  .coffee-tile:nth-child(1),
  .coffee-tile:nth-child(5) {
    grid-column: span 7;
  }

  .coffee-tile:nth-child(2),
  .coffee-tile:nth-child(6) {
    grid-column: span 5;
  }

  .coffee-tile:nth-child(3) {
    grid-column: 3 / span 8;
  }

  .coffee-tile img {
    width: 100%;
    aspect-ratio: 16 / 10;
    display: block;
    object-fit: cover;
    object-position: top;
    border: 1px solid rgba(22, 23, 19, 0.25);
    filter: saturate(0.82);
    transition: filter 200ms ease, transform 250ms ease;
  }

  .coffee-tile:hover img {
    filter: saturate(1);
    transform: translateY(-4px);
  }

  .coffee-tile figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0 1rem;
    font-size: 0.8rem;
  }

  .coffee-tile figcaption span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .series-link {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding: 1rem 0;
    border-top: 1px solid var(--on-acid);
    border-bottom: 1px solid var(--on-acid);
    color: var(--on-acid);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
  }

  .coffee-section a:hover {
    color: var(--on-acid);
  }

  @media (max-width: 900px) {
    .work-heading,
    .coffee-heading {
      grid-template-columns: 1fr;
    }

    .work-heading > div > p { margin-bottom: 0; }

    .project {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .project:nth-child(even) .project-media {
      order: 0;
    }
  }

  @media (max-width: 620px) {
    .work-inner,
    .coffee-inner { padding-inline: 1rem; }
    .coffee-gallery { gap: 0.75rem; }
    .coffee-tile,
    .coffee-tile:nth-child(1),
    .coffee-tile:nth-child(2),
    .coffee-tile:nth-child(3),
    .coffee-tile:nth-child(5),
    .coffee-tile:nth-child(6) { grid-column: span 12; }
    .open-mark { opacity: 1; transform: none; }
  }
</style>
