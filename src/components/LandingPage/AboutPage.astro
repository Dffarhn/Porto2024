---
const stats = [
  { value: "5+", label: "years building software" },
  { value: "10", label: "production systems shipped" },
  { value: "150+", label: "students mentored" },
  { value: "2", label: "awards earned" },
];

const stack = ["Golang", "NestJS", "Next.js", "PostgreSQL", "Redis", "Docker", "OpenAI", "CI/CD"];
---

<div class="profile-section">
  <div class="profile-inner">
    <header class="section-heading">
      <p class="section-index">01 / Profile</p>
      <h2>I work where complex systems meet <em>clear experiences.</em></h2>
    </header>

    <div class="profile-grid">
      <div class="profile-statement">
        <p class="lead">
          I’m an informatics researcher and full-stack engineer building end-to-end products:
          backend services, web platforms, mobile systems, and applied AI.
        </p>
        <p>
          My work goes beyond getting a feature to run. I care about the architecture behind it,
          the deployment path around it, and whether it creates measurable value after launch.
        </p>
      </div>

      <div class="stats-grid" aria-label="Career highlights">
        {stats.map((stat) => (
          <article class="stat">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>

    <div class="stack-row">
      <p>Core toolkit</p>
      <ul>
        {stack.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</div>

<style>
  .profile-section {
    padding: clamp(5rem, 10vw, 9rem) 1.5rem;
    background: var(--dark-surface);
    color: var(--on-dark);
  }

  .profile-inner {
    max-width: 1380px;
    margin: 0 auto;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) 1.65fr;
    gap: 2rem;
    padding-bottom: clamp(3rem, 7vw, 6rem);
    border-bottom: 1px solid rgba(242, 240, 232, 0.28);
  }

  .section-index {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--on-dark);
    font-size: clamp(2.8rem, 6vw, 6.25rem);
    font-weight: 500;
    letter-spacing: -0.07em;
  }

  h2 em {
    color: var(--acid);
    font-weight: 400;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 7vw, 5rem);
    padding: clamp(3rem, 7vw, 6rem) 0;
  }

  .profile-statement {
    max-width: 52rem;
    display: grid;
    grid-template-columns: minmax(280px, 1.2fr) minmax(240px, 0.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .profile-statement p {
    margin: 0;
    color: var(--on-dark-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .profile-statement .lead {
    margin-bottom: 0;
    color: var(--on-dark);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(242, 240, 232, 0.28);
    border-bottom: 1px solid rgba(242, 240, 232, 0.28);
  }

  .stat {
    min-height: 155px;
    padding: 1.4rem 1.5rem;
    display: grid;
    align-content: end;
    gap: 1.25rem;
    border-right: 1px solid rgba(242, 240, 232, 0.28);
    transition: color 200ms ease;
  }

  .stat:first-child {
    padding-left: 0;
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat > span:last-child {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .stat strong {
    color: var(--on-dark);
    font-size: clamp(2.6rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.9;
    transition: color 200ms ease;
  }

  .stat:hover strong {
    color: var(--acid);
  }

  .stack-row {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) 1.65fr;
    gap: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(242, 240, 232, 0.28);
  }

  .stack-row p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .stack-row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-row li {
    padding: 0.55rem 0.85rem;
    border: 1px solid rgba(242, 240, 232, 0.3);
    border-radius: 999px;
    color: var(--on-dark);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 760px) {
    .profile-section { padding-inline: 1rem; }
    .section-heading,
    .profile-statement,
    .stack-row { grid-template-columns: 1fr; }
    .profile-grid { gap: 3rem; }
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat {
      min-height: 130px;
      padding: 1.25rem;
      border-bottom: 1px solid rgba(242, 240, 232, 0.28);
    }
    .stat:first-child { padding-left: 1.25rem; }
    .stat:nth-child(2n) { border-right: 0; }
    .stat:nth-last-child(-n + 2) { border-bottom: 0; }
  }
</style>
