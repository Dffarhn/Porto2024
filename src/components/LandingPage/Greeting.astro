---
import { Image } from "astro:assets";
import PhotoDiri from "../../assets/fotopribadi.jpg";
import SocialComponent from "../LandingPage/SocialMedia.astro";
import instagrampicture from "../../assets/social/instagram.png";
import LinkedlnPicture from "../../assets/social/linkedin.png";
import GithubPicture from "../../assets/social/github.png";

const socialLinks = [
  { href: "https://instagram.com/dffar.hn", imgSrc: instagrampicture, alt: "Instagram" },
  { href: "https://github.com/Dffarhn", imgSrc: GithubPicture, alt: "GitHub" },
  { href: "https://linkedin.com/in/dapdap", imgSrc: LinkedlnPicture, alt: "LinkedIn" },
];
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-text">
        <div class="greeting-badge">
          <span class="greeting-icon">👋</span>
          <span>Hello there</span>
        </div>
        
        <h1 class="hero-title">
          <span class="gradient-text">Full Stack Engineer</span> who builds scalable systems and AI-powered products.
        </h1>
        
        <p class="hero-description">
          I build backend, web, and mobile applications from zero to production  from system design
          and CI/CD automation to AI features used by thousands of users.
        </p>
        
        <div class="hero-cta">
          <a href="#projects" class="primary-button">
            <span>View Projects</span>
            <span
              class="w-5 h-5"
              aria-hidden="true"
              set:html={`<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`}
            />
          </a>
          
          <a href="/project/CV.pdf" download class="secondary-button">
            <span>Download CV</span>
            <span
              class="w-5 h-5"
              aria-hidden="true"
              set:html={`<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>`}
            />
          </a>
          
          <a href="#contact" class="secondary-button">
            <span>Contact Me</span>
            <span
              class="w-5 h-5"
              aria-hidden="true"
              set:html={`<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>`}
            />
          </a>
        </div>
      </div>
    </div>
    
    <div class="hero-image-container">
      <div class="image-frame">
        <Image class="profile-image" src={PhotoDiri} alt="Muhammad Daffa Raihan" />
        <div class="image-backdrop"></div>
      </div>
      <SocialComponent Social={socialLinks} />
    </div>
  </div>
  
  <div class="hero-background">
    <div class="gradient-blob gradient-blob-1"></div>
    <div class="gradient-blob gradient-blob-2"></div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 1.5rem 4rem;
    overflow: hidden;
  }
  
  .hero-container {
    display: flex;
    flex-direction: column-reverse;
    gap: 3rem;
    width: 100%;
    max-width: 1200px;
    z-index: 10;
    position: relative;
  }
  
  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .hero-text {
    max-width: 600px;
  }
  
  .greeting-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(var(--primary), 0.1);
    border: 1px solid rgba(var(--primary), 0.2);
    border-radius: 50px;
    padding: 0.5rem 1rem;
    margin-bottom: 1.5rem;
    font-weight: 500;
    color: rgb(var(--primary));
  }
  
  .greeting-icon {
    margin-right: 0.5rem;
    animation: wave 2.5s infinite;
    display: inline-block;
    transform-origin: 70% 70%;
  }
  
  @keyframes wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }
  
  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: rgb(var(--text));
  }
  
  .gradient-text {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  
  .hero-subtitle {
    font-size: 1.25rem;
    color: rgb(var(--text-muted));
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  
  .hero-description {
    font-size: 1.1rem;
    color: rgb(var(--text-muted));
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--gradient-primary);
    color: white;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(var(--primary), 0.4);
  }
  
  .primary-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(var(--primary), 0.6);
  }
  
  .secondary-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(var(--text), 0.1);
    color: rgb(var(--text));
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid rgba(var(--text), 0.2);
  }
  
  .secondary-button:hover {
    background: rgba(var(--text), 0.15);
    transform: translateY(-2px);
  }
  
  .hero-image-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  
  .image-frame {
    position: relative;
    width: 280px;
    height: 280px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }
  
  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .image-frame:hover .profile-image {
    transform: scale(1.05);
  }
  
  .image-backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
  }
  
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  
  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(55px);
    opacity: 0.12;
  }
  
  .gradient-blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(var(--primary), 0.45), rgba(var(--primary), 0));
    top: -100px;
    right: -100px;
    animation: float 8s ease-in-out infinite alternate;
  }
  
  .gradient-blob-2 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(var(--secondary), 0.4), rgba(var(--secondary), 0));
    bottom: -200px;
    left: -200px;
    animation: float 10s ease-in-out infinite alternate-reverse;
  }
  
  @keyframes float {
    0% { transform: translate(0, 0) rotate(0deg); }
    100% { transform: translate(50px, 50px) rotate(10deg); }
  }
  
  @media (min-width: 768px) {
    .hero-container {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
    
    .hero-content {
      flex: 1;
    }
    
    .hero-image-container {
      flex: 1;
    }
    
    .hero-title {
      font-size: 3.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    .hero-section {
      padding-top: 10rem;
    }
    
    .image-frame {
      width: 350px;
      height: 350px;
    }
  }
</style>
