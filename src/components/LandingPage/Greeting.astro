---
import { Image } from "astro:assets";
import PhotoDiri from "../../assets/fotopribadi.jpg";

const socialLinks = [
  { href: "https://github.com/Dffarhn", label: "GitHub" },
  { href: "https://linkedin.com/in/dapdap", label: "LinkedIn" },
  { href: "https://instagram.com/dffar.hn", label: "Instagram" },
];
---

<section class="hero">
  <div class="hero-shell">
    <div class="hero-topline">
      <p>Daffa Raihan / Full-stack engineer</p>
      <p class="availability"><span></span> Available for selected work</p>
      <p>Yogyakarta · ID</p>
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-index">Portfolio / 2026</p>
        <h1 class="hero-title">
          Systems that<br />
          <span>ship.</span> Products<br />
          that matter.
        </h1>
        <div class="hero-bottom">
          <p class="hero-lead">
            I design and build production software—from backend architecture and automation to AI products used by real people.
          </p>
          <div class="hero-actions">
            <a href="#projects" class="btn btn-solid">Explore selected work <span>↘</span></a>
            <a href="/project/CV.pdf" download class="btn btn-ghost">Download CV</a>
          </div>
        </div>
      </div>

      <aside class="hero-visual">
        <div class="portrait-wrap">
          <span class="portrait-label">Engineer / Builder / Researcher</span>
          <Image class="profile-image" src={PhotoDiri} alt="Muhammad Daffa Raihan" />
          <span class="portrait-mark">DR.</span>
        </div>
        <div class="visual-note">
          <span>Current focus</span>
          <strong>Automation, backend systems & applied AI.</strong>
        </div>
      </aside>
    </div>

    <div class="hero-footer">
      <div class="hero-social">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
        ))}
      </div>
      <p>Scroll to discover <span>↓</span></p>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    padding: 6.5rem 1.5rem 1.5rem;
    background: var(--paper);
  }

  .hero-shell {
    width: 100%;
    max-width: 1380px;
    margin: 0 auto;
    min-height: calc(100svh - 8rem);
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .hero-topline,
  .hero-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-topline p,
  .hero-footer p {
    margin: 0;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .availability span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px rgba(49, 87, 255, 0.12);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(290px, 0.65fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
    padding: 2.5rem 0;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-index {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--primary));
  }

  .hero-title {
    font-size: clamp(3.7rem, 7.3vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.84;
    margin: 0;
    max-width: 10ch;
  }

  .hero-title span {
    color: var(--signal);
    font-style: italic;
    font-weight: 400;
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) 1fr;
    gap: 1.5rem;
    align-items: end;
    margin-top: clamp(2.5rem, 6vw, 5.5rem);
  }

  .hero-lead {
    margin: 0;
    max-width: 29rem;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.5;
    color: rgb(var(--text-muted));
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: flex-end;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast);
  }

  .btn:hover {
    opacity: 1;
  }

  .btn-solid {
    background: var(--ink);
    color: var(--paper);
    gap: 1.25rem;
  }

  .btn-solid:hover {
    color: white;
    background: var(--signal-surface);
  }

  .btn-ghost {
    color: var(--ink);
    border: 1px solid var(--ink);
  }

  .btn-ghost:hover {
    color: var(--signal);
    border-color: var(--signal);
  }

  .hero-social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .hero-social a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 1.1vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
    border-bottom: 1px solid transparent;
  }

  .hero-social a:hover {
    color: var(--signal);
    border-color: var(--signal);
    opacity: 1;
  }

  .hero-visual {
    align-self: stretch;
    display: grid;
    align-content: center;
    gap: 1rem;
  }

  .portrait-wrap {
    position: relative;
    padding: 0.75rem;
    background: var(--signal-surface);
    transform: rotate(1.4deg);
    transition: transform 350ms ease;
  }

  .portrait-wrap:hover {
    transform: rotate(0deg);
  }

  .portrait-label {
    display: block;
    margin: 0 0 0.65rem;
    color: white;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .profile-image {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.75) contrast(1.05);
    display: block;
  }

  .portrait-mark {
    position: absolute;
    right: -0.15rem;
    bottom: -0.7rem;
    color: var(--acid);
    font-size: clamp(2.8rem, 5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .visual-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(var(--text), 0.35);
  }

  .visual-note span {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  .visual-note strong {
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .hero-footer {
    border-top: 1px solid rgba(var(--text), 0.25);
    padding-block: 1rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      padding-top: 3.5rem;
    }

    .hero-bottom {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .hero-visual {
      grid-template-columns: minmax(210px, 330px) minmax(180px, 1fr);
      align-items: end;
    }
  }

  @media (max-width: 620px) {
    .hero {
      padding: 5.75rem 1rem 1rem;
    }

    .hero-topline p:nth-child(3) {
      display: none;
    }

    .hero-title {
      font-size: clamp(3.2rem, 15.5vw, 5rem);
    }

    .hero-visual {
      grid-template-columns: 1fr;
      margin-top: 1rem;
    }

    .portrait-wrap {
      max-width: 300px;
    }

    .hero-footer {
      align-items: flex-end;
    }

    .hero-footer > p {
      display: none;
    }

    .hero-social {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .hero-social a {
      font-size: 0.8rem;
    }

    .btn {
      width: 100%;
    }
  }
</style>
