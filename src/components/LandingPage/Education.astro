---
const education = [
  {
    level: "Master’s",
    period: "2026 — 2028",
    degree: "M.Kom. Informatics",
    school: "Universitas Islam Indonesia",
    note: "Research Assistant Scholarship · Fully funded",
    focus: "AI, Big Data, Deep Learning, Explainable AI",
  },
  {
    level: "Bachelor’s",
    period: "2022 — 2026",
    degree: "S.Kom. Informatics",
    school: "Universitas Islam Indonesia",
    note: "GPA 3.97 / 4.00 · Cum Laude · Gold Pin",
    focus: "Software engineering, distributed systems, applied AI",
  },
  {
    level: "High school",
    period: "2019 — 2022",
    degree: "STEM Program",
    school: "MAN Insan Cendekia",
    note: "GPA 88 / 100",
    focus: "Mathematics and problem solving",
  },
];
---

<div class="education-section">
  <div class="education-inner">
    <header class="section-heading">
      <p class="section-index">06 / Education</p>
      <h2>Always building.<br /><em>Always learning.</em></h2>
    </header>

    <div class="education-grid">
      {education.map((item, index) => (
        <article class:list={["education-card", { featured: index === 0 }]}>
          <div class="card-top">
            <span>{item.level}</span>
            <span>{item.period}</span>
          </div>
          <div>
            <h3>{item.degree}</h3>
            <p class="school">{item.school}</p>
          </div>
          <div class="card-bottom">
            <p>{item.note}</p>
            <p><span>Focus</span>{item.focus}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .education-section {
    padding: clamp(5rem, 10vw, 9rem) 1.5rem;
    background: var(--paper);
  }

  .education-inner {
    max-width: 1380px;
    margin: 0 auto;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) 1.65fr;
    gap: 2rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .section-index {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  h2 {
    margin: 0;
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  h2 em {
    color: var(--signal);
    font-weight: 400;
  }

  .education-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 1px;
    background: var(--ink);
    border: 1px solid var(--ink);
  }

  .education-card {
    min-height: 390px;
    padding: 1.5rem;
    display: grid;
    align-content: space-between;
    background: var(--paper-light);
    transition: background 200ms ease, color 200ms ease;
  }

  .education-card:hover,
  .education-card.featured {
    background: var(--acid);
    color: var(--on-acid);
  }

  .education-card:hover .card-top,
  .education-card:hover h3,
  .education-card:hover .school,
  .education-card:hover .card-bottom p:last-child,
  .education-card.featured .card-top,
  .education-card.featured h3,
  .education-card.featured .school,
  .education-card.featured .card-bottom p:last-child {
    color: var(--on-acid);
  }

  .education-card:hover .card-top,
  .education-card:hover .school,
  .education-card:hover .card-bottom p:last-child,
  .education-card.featured .card-top,
  .education-card.featured .school,
  .education-card.featured .card-bottom p:last-child {
    color: rgba(22, 23, 19, 0.68);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  h3 {
    margin: 0 0 0.4rem;
    font-size: clamp(2rem, 3vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .school {
    margin: 0;
    color: rgb(var(--text-muted));
  }

  .card-bottom {
    border-top: 1px solid rgba(var(--text), 0.35);
    padding-top: 1rem;
  }

  .education-card:hover .card-bottom,
  .education-card.featured .card-bottom {
    border-color: rgba(22, 23, 19, 0.35);
  }

  .card-bottom p {
    margin: 0 0 0.7rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .card-bottom p:last-child {
    margin-bottom: 0;
    color: rgb(var(--text-muted));
  }

  .card-bottom span {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .education-grid { grid-template-columns: 1fr; }
    .education-card { min-height: 310px; }
  }

  @media (max-width: 620px) {
    .education-section { padding-inline: 1rem; }
    .section-heading { grid-template-columns: 1fr; }
  }
</style>
