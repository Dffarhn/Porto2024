---
import HamburgerMenu from "./HamburgerMenu.astro";

const { navigasi } = Astro.props;
---

<header class="fixed w-full top-0 z-50">
  <nav class="glass-nav backdrop-blur-lg">
    <div class="navbar-container">
      <div class="navbar-logo">
        <a href="/" class="logo-link">
          <span class="logo-text">Dffa</span>
          <span class="logo-gradient">Raihan</span>
        </a>
      </div>

      <div class="navbar-links">
        <ul class="navbar-menu">
          {navigasi.map((link) => (
            <li class="navbar-item">
              <a href={link.href} class="navbar-link group">
                <span class="link-text">{link.text}</span>
                <span class="link-underline"></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="mobile-menu">
          <HamburgerMenu />
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  .glass-nav {
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .navbar-container {
    max-width: 1900px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    letter-spacing: -0.025em;
  }

  .logo-text {
    color: rgb(var(--text));
  }

  .logo-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-left: 4px;
  }

  .navbar-menu {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .navbar-link {
    position: relative;
    color: rgb(var(--text));
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
  }

  .link-underline {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-primary);
    transition: width 0.3s ease;
  }

  .navbar-link:hover .link-underline {
    width: 100%;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 768px) {
    .navbar-menu {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  /* Add scroll effect styles */
  header.scrolled .glass-nav {
    background: rgba(15, 23, 42, 0.95);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  // Add scroll effect to navbar
  const header = document.querySelector('header');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });
</script>
