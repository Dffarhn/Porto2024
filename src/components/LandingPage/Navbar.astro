---
import HamburgerMenu from "./HamburgerMenu.astro";

interface NavLink {
  href: string;
  text: string;
}

interface Props {
  navigasi: NavLink[];
}

const { navigasi } = Astro.props as Props;
---

<header class="site-header" id="site-header">
  <nav class="glass-nav backdrop-blur-lg" aria-label="Primary">
    <div class="navbar-container">
      <div class="navbar-logo">
        <a href="/" class="logo-link" aria-label="Dffa Raihan  Home">
          <img
            src="/logo.png"
            alt=""
            width="36"
            height="36"
            class="logo-img"
            decoding="async"
            fetchpriority="high"
          />
          <span class="logo-text">Daffa Raihan <small>©26</small></span>
        </a>
      </div>

      <div class="navbar-links">
        <ul class="navbar-menu" id="desktop-nav-menu">
          {navigasi.map((link) => (
            <li class="navbar-item">
              <a href={link.href} class="navbar-link group">
                <span class="link-text">{link.text}</span>
                <span class="link-underline"></span>
              </a>
            </li>
          ))}
        </ul>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Switch to dark mode"
          title="Toggle color theme"
        >
          <svg class="theme-icon sun-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
          </svg>
          <svg class="theme-icon moon-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path>
          </svg>
          <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
          <span class="theme-label">Theme</span>
        </button>
        <div class="mobile-menu-toggle">
          <HamburgerMenu />
        </div>
      </div>
    </div>
  </nav>

  <!-- Mobile: backdrop + panel (controlled by script) -->
  <div
    id="mobile-nav-backdrop"
    class="mobile-nav-backdrop"
    aria-hidden="true"
    hidden
  ></div>
  <div
    id="mobile-nav-panel"
    class="mobile-nav-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    aria-hidden="true"
    hidden
  >
    <ul class="mobile-nav-list">
      {navigasi.map((link) => (
        <li>
          <a href={link.href} class="mobile-nav-link">{link.text}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.75rem 1.5rem 0;
    pointer-events: none;
  }

  .glass-nav {
    max-width: 1380px;
    margin: 0 auto;
    background: rgba(var(--background), 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(var(--text), 0.45);
    border-radius: 999px;
    transition: background 0.2s ease, box-shadow 0.2s ease;
    pointer-events: auto;
  }

  .navbar-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0.45rem 0.65rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 2.75rem;
  }

  @media (min-width: 640px) {
    .navbar-container {
      padding: 0.45rem 0.75rem;
    }
  }

  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: -0.03em;
    flex-shrink: 0;
  }

  .logo-img {
    height: 2rem;
    width: auto;
    aspect-ratio: 1;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 10px;
  }

  .logo-text {
    color: var(--ink);
  }

  .logo-text small {
    margin-left: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: rgb(var(--text-muted));
  }

  .navbar-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    min-width: 0;
    flex: 1;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 2.35rem;
    min-height: 2.35rem;
    padding: 0.4rem 0.65rem;
    border: 1px solid rgba(var(--text), 0.35);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
  }

  .theme-toggle:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .theme-icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .moon-icon { display: none; }
  :global([data-theme="dark"]) .sun-icon { display: none; }
  :global([data-theme="dark"]) .moon-icon { display: block; }

  .switch-track {
    width: 1.85rem;
    height: 1rem;
    padding: 2px;
    display: flex;
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .switch-thumb {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: currentColor;
    transform: translateX(0);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global([data-theme="dark"]) .switch-thumb {
    transform: translateX(0.78rem);
  }

  .theme-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .navbar-menu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    row-gap: 0.25rem;
  }

  .navbar-link {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.35rem 0;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .link-underline {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--signal);
    transition: width 0.3s ease;
  }

  .navbar-link:hover .link-underline,
  .navbar-link:focus-visible .link-underline {
    width: 100%;
  }

  .navbar-link:focus-visible {
    outline: 2px solid rgba(var(--primary), 0.5);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Desktop / large tablet: horizontal nav */
  @media (min-width: 1025px) {
    .navbar-menu {
      display: flex;
    }

    .mobile-menu-toggle {
      display: none;
    }
  }

  /* Backdrop + panel (mobile / narrow screens) */
  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    top: var(--nav-offset, 56px);
    background: rgba(var(--text), 0.4);
    z-index: 90;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    pointer-events: none;
  }

  .mobile-nav-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav-panel {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--nav-offset, 56px);
    z-index: 95;
    max-height: min(70vh, 520px);
    overflow-y: auto;
    margin: 0 1rem;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 16px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    transform: translateY(-8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.22s ease, opacity 0.22s ease, visibility 0.22s ease;
  }

  .mobile-nav-panel.is-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.85rem 1rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 1.1rem;
    border-radius: 10px;
    transition: background 0.15s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background: rgba(var(--primary), 0.12);
    outline: none;
  }

  .site-header.scrolled .glass-nav {
    background: rgba(var(--background-light), 0.96);
    box-shadow: 0 8px 28px rgba(var(--text), 0.08);
  }

  @media (max-width: 640px) {
    .site-header { padding: 0.65rem 0.75rem 0; }
    .logo-text small { display: none; }
    .navbar-links { gap: 0.55rem; }
    .theme-toggle { padding-inline: 0.6rem; }
    .theme-label { display: none; }
  }

  body.nav-open {
    overflow: hidden;
  }
</style>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle || toggle.dataset.initialized === "true") return;
    toggle.dataset.initialized = "true";

    const syncLabel = () => {
      const dark = document.documentElement.dataset.theme === "dark";
      toggle.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
      toggle.setAttribute("aria-pressed", String(dark));
    };

    syncLabel();
    toggle.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      document.documentElement.style.colorScheme = next;
      localStorage.setItem("theme", next);
      document.querySelector('meta[name="theme-color"]')?.setAttribute(
        "content",
        next === "dark" ? "#11120f" : "#f2f0e8",
      );
      syncLabel();
    });
  }

  function initNav() {
    const header = document.getElementById("site-header");
    const hamburger = document.getElementById("hamburger");
    const backdrop = document.getElementById("mobile-nav-backdrop");
    const panel = document.getElementById("mobile-nav-panel");

    function setNavOffset() {
      const h = header?.offsetHeight ?? 56;
      document.documentElement.style.setProperty("--nav-offset", `${h}px`);
    }

    setNavOffset();
    window.addEventListener("resize", setNavOffset);

    function closeMobileNav() {
      hamburger?.classList.remove("active");
      hamburger?.setAttribute("aria-expanded", "false");
      hamburger?.setAttribute("aria-label", "Open menu");
      backdrop?.classList.remove("is-open");
      panel?.classList.remove("is-open");
      backdrop?.setAttribute("aria-hidden", "true");
      panel?.setAttribute("aria-hidden", "true");
      backdrop?.setAttribute("hidden", "");
      panel?.setAttribute("hidden", "");
      document.body.classList.remove("nav-open");
    }

    function openMobileNav() {
      setNavOffset();
      hamburger?.classList.add("active");
      hamburger?.setAttribute("aria-expanded", "true");
      hamburger?.setAttribute("aria-label", "Close menu");
      backdrop?.classList.add("is-open");
      panel?.classList.add("is-open");
      backdrop?.removeAttribute("hidden");
      panel?.removeAttribute("hidden");
      backdrop?.setAttribute("aria-hidden", "false");
      panel?.setAttribute("aria-hidden", "false");
      document.body.classList.add("nav-open");
    }

    function toggleMobileNav() {
      const open = panel?.classList.contains("is-open");
      if (open) closeMobileNav();
      else openMobileNav();
    }

    hamburger?.addEventListener("click", (e) => {
      e.preventDefault();
      toggleMobileNav();
    });

    backdrop?.addEventListener("click", () => closeMobileNav());

    panel?.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => closeMobileNav());
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1025) closeMobileNav();
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel?.classList.contains("is-open")) {
        closeMobileNav();
      }
    });

    window.addEventListener("scroll", () => {
      if (!header) return;
      if (window.scrollY > 50) header.classList.add("scrolled");
      else header.classList.remove("scrolled");
    });
  }

  initNav();
  initThemeToggle();
  document.addEventListener("astro:page-load", initNav);
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
