---
---

<div class="work-experience-section">
  <div class="section-background">
    <div class="gradient-blob blob-1"></div>
    <div class="gradient-blob blob-2"></div>
    <div class="gradient-blob blob-3"></div>
  </div>
  <div class="section-header">
    <h2 class="section-title">Work Experience</h2>
    <p class="section-subtitle">
      Saya memiliki pengalaman bekerja di berbagai lingkungan, mulai dari startup, industri, riset akademik, hingga sistem production dengan real users.
    </p>
  </div>

  <div class="experience-timeline">
    <!-- Emica -->
    <div class="experience-item">
      <div class="experience-marker">
        <div class="marker-dot"></div>
        <div class="marker-line"></div>
      </div>
      <div class="experience-content">
        <div class="experience-header">
          <div class="experience-title-group">
            <h3 class="experience-position">Full Stack Web Developer</h3>
            <p class="experience-company">Emica</p>
          </div>
          <span class="experience-period">Jun 2025 – Present</span>
        </div>
        <p class="experience-description">
          Mengembangkan dan memelihara full-stack web application untuk produk client-facing
          yang digunakan di lingkungan production.
        </p>
        <div class="experience-details">
          <div class="detail-section">
            <h4 class="detail-title">Kontribusi utama:</h4>
            <ul class="detail-list">
              <li>Membangun backend system dan database schema menggunakan Node.js dan PostgreSQL</li>
              <li>Mengelola data reservasi, customer, dan analytics</li>
              <li>Mengembangkan frontend dashboard dengan React untuk visualisasi metrics</li>
              <li>Mengimplementasikan WhatsApp booking & analytics system</li>
            </ul>
          </div>
          <div class="impact-badge">
            <span class="impact-icon">📊</span>
            <div class="impact-content">
              <strong>Impact:</strong> Mendukung ±3.900 reservasi dari real users • Mencapai 85% click-to-contact conversion rate
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Fakultas Teknologi Industri -->
    <div class="experience-item">
      <div class="experience-marker">
        <div class="marker-dot"></div>
        <div class="marker-line"></div>
      </div>
      <div class="experience-content">
        <div class="experience-header">
          <div class="experience-title-group">
            <h3 class="experience-position">Asisten Laboratorium Informatika</h3>
            <p class="experience-company">Fakultas Teknologi Industri</p>
          </div>
          <span class="experience-period">Sep 2023 – Jan 2026</span>
        </div>
        <p class="experience-description">
          Berperan sebagai asisten pengajar dan mentor untuk mata kuliah inti Informatika
          seperti Programming Logic, Web Development, Algorithm & Data Structures,
          serta Computer Networks & Systems.
        </p>
        <div class="experience-details">
          <div class="detail-section">
            <h4 class="detail-title">Kontribusi:</h4>
            <ul class="detail-list">
              <li>Membimbing lebih dari 150+ mahasiswa dalam praktikum dan tugas teknis</li>
              <li>Membantu hands-on debugging dan problem solving</li>
              <li>Menjembatani konsep teknis kompleks menjadi penjelasan praktis</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Savebite -->
    <div class="experience-item">
      <div class="experience-marker">
        <div class="marker-dot"></div>
        <div class="marker-line"></div>
      </div>
      <div class="experience-content">
        <div class="experience-header">
          <div class="experience-title-group">
            <h3 class="experience-position">Full Stack Mobile Developer</h3>
            <p class="experience-company">Savebite</p>
          </div>
          <span class="experience-period">Aug 2024 – Jan 2025</span>
        </div>
        <p class="experience-description">
          Mengembangkan backend services untuk aplikasi mobile berbasis food-tech
          yang menghubungkan mobile client dengan server.
        </p>
        <div class="experience-details">
          <div class="detail-section">
            <h4 class="detail-title">Kontribusi:</h4>
            <ul class="detail-list">
              <li>Membangun RESTful API menggunakan Node.js dan Express</li>
              <li>Mendesain relational database schema</li>
              <li>Mengembangkan fitur Android menggunakan Jetpack Compose</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- TEDXUII -->
    <div class="experience-item experience-item-last">
      <div class="experience-marker">
        <div class="marker-dot"></div>
      </div>
      <div class="experience-content">
        <div class="experience-header">
          <div class="experience-title-group">
            <h3 class="experience-position">Back-End Developer</h3>
            <p class="experience-company">TEDXUII</p>
          </div>
          <span class="experience-period">May 2024 – Jun 2024</span>
        </div>
        <p class="experience-description">
          Mengembangkan backend API untuk web-based ticketing system.
        </p>
        <div class="experience-details">
          <div class="detail-section">
            <h4 class="detail-title">Kontribusi:</h4>
            <ul class="detail-list">
              <li>Implementasi RESTful API menggunakan Express.js</li>
              <li>Integrasi PostgreSQL dan Redis untuk transactional processing</li>
              <li>Deployment backend ke VPS untuk production usage</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .work-experience-section {
    width: 100%;
    max-width: 1200px;
    margin: 6rem auto;
    padding: 0 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .section-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(85px);
    opacity: 0.28;
  }

  .blob-1 {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(var(--secondary), 0.65), rgba(var(--secondary), 0));
    top: -100px;
    right: -120px;
    animation: float-work-1 13s ease-in-out infinite alternate;
  }

  .blob-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(var(--primary), 0.55), rgba(var(--primary), 0));
    bottom: -180px;
    left: -100px;
    animation: float-work-2 17s ease-in-out infinite alternate-reverse;
  }

  .blob-3 {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(var(--accent), 0.45), rgba(var(--accent), 0));
    top: 40%;
    right: 20%;
    animation: float-work-3 11s ease-in-out infinite alternate;
  }

  @keyframes float-work-1 {
    0% { transform: translate(0, 0) rotate(0deg); }
    100% { transform: translate(-35px, 45px) rotate(-12deg); }
  }

  @keyframes float-work-2 {
    0% { transform: translate(0, 0) rotate(0deg); }
    100% { transform: translate(45px, -35px) rotate(18deg); }
  }

  @keyframes float-work-3 {
    0% { transform: translate(0, 0) rotate(0deg); }
    100% { transform: translate(25px, 30px) rotate(8deg); }
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
    z-index: 1;
  }

  .section-title {
    font-size: 3rem;
    font-weight: 700;
    color: rgb(var(--text));
    margin: 0 0 1rem 0;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: rgb(var(--text-muted));
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
  }

  .experience-timeline {
    position: relative;
    padding-left: 2rem;
    z-index: 1;
  }

  .experience-item {
    position: relative;
    margin-bottom: 3rem;
    display: flex;
    gap: 2rem;
  }

  .experience-item-last {
    margin-bottom: 0;
  }

  .experience-marker {
    position: relative;
    flex-shrink: 0;
    width: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .marker-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--gradient-primary);
    border: 3px solid rgb(var(--background));
    box-shadow: 0 0 0 3px rgba(var(--primary), 0.2);
    z-index: 2;
    position: relative;
  }

  .marker-line {
    width: 2px;
    flex: 1;
    background: linear-gradient(
      to bottom,
      rgba(var(--primary), 0.5),
      rgba(var(--secondary), 0.3)
    );
    margin-top: 0.5rem;
    min-height: 100px;
  }

  .experience-item-last .marker-line {
    display: none;
  }

  .experience-content {
    flex: 1;
    background: var(--gradient-card);
    border: 1px solid rgba(var(--border), 0.2);
    border-radius: 20px;
    padding: 2rem;
    transition: all var(--transition-normal);
    position: relative;
    overflow: hidden;
  }

  .experience-content::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .experience-content:hover {
    transform: translateX(8px);
    box-shadow: var(--shadow-xl);
    border-color: rgba(var(--primary), 0.4);
  }

  .experience-content:hover::before {
    opacity: 1;
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .experience-title-group {
    flex: 1;
  }

  .experience-position {
    font-size: 1.5rem;
    font-weight: 700;
    color: rgb(var(--text));
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .experience-company {
    font-size: 1.125rem;
    color: rgb(var(--primary));
    font-weight: 600;
    margin: 0;
  }

  .experience-period {
    font-size: 0.95rem;
    color: rgb(var(--text-muted));
    font-weight: 500;
    white-space: nowrap;
    padding: 0.5rem 1rem;
    background: rgba(var(--primary), 0.1);
    border-radius: 8px;
    border: 1px solid rgba(var(--primary), 0.2);
  }

  .experience-description {
    font-size: 1rem;
    color: rgb(var(--text-muted));
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .experience-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .detail-section {
    background: rgba(var(--background-light), 0.5);
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgba(var(--border), 0.1);
  }

  .detail-title {
    font-size: 1rem;
    font-weight: 600;
    color: rgb(var(--text));
    margin: 0 0 1rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .detail-title::before {
    content: '▸';
    color: rgb(var(--primary));
    font-size: 1.2rem;
  }

  .detail-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .detail-list li {
    position: relative;
    padding-left: 1.5rem;
    color: rgb(var(--text));
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .detail-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: rgb(var(--primary));
    font-weight: bold;
    font-size: 1.2rem;
  }

  .impact-badge {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: linear-gradient(
      135deg,
      rgba(var(--primary), 0.15),
      rgba(var(--secondary), 0.1)
    );
    border: 1px solid rgba(var(--primary), 0.3);
    border-radius: 12px;
    padding: 1.25rem;
    border-left: 4px solid rgb(var(--primary));
  }

  .impact-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .impact-content {
    flex: 1;
    color: rgb(var(--text));
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .impact-content strong {
    color: rgb(var(--primary));
    font-weight: 600;
  }

  @media (max-width: 1024px) {
    .work-experience-section {
      padding: 0 1rem;
    }

    .section-title {
      font-size: 2.5rem;
    }

    .experience-timeline {
      padding-left: 1.5rem;
    }

    .experience-item {
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .work-experience-section {
      margin: 4rem auto;
    }

    .section-title {
      font-size: 2rem;
    }

    .section-subtitle {
      font-size: 1rem;
    }

    .experience-timeline {
      padding-left: 1rem;
    }

    .experience-item {
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .experience-marker {
      width: 1.5rem;
    }

    .marker-dot {
      width: 12px;
      height: 12px;
    }

    .experience-content {
      padding: 1.5rem;
    }

    .experience-header {
      flex-direction: column;
    }

    .experience-period {
      align-self: flex-start;
    }

    .experience-position {
      font-size: 1.25rem;
    }

    .experience-company {
      font-size: 1rem;
    }

    .detail-section {
      padding: 1rem;
    }

    .impact-badge {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .section-title {
      font-size: 1.75rem;
    }

    .experience-content {
      padding: 1.25rem;
      border-radius: 16px;
    }

    .experience-position {
      font-size: 1.125rem;
    }
  }
</style>
