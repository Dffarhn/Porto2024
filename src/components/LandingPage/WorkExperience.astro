---
const experiences = [
  {
    company: "QBIT",
    period: "Jan 2026 — Present",
    role: "Intern Full Stack Web Developer",
    summary: "Building modular backends and AI workflows for production needs.",
    details: ["NestJS monorepo architecture", "RAG workflows with n8n", "AI chatbot and live chat", "Document automation"],
  },
  {
    company: "Emica",
    period: "Jun 2025 — Present",
    role: "Full Stack Web Developer",
    summary: "Developing a client-facing product used for reservations, customer operations, and analytics.",
    details: ["Node.js and PostgreSQL systems", "React analytics dashboard", "WhatsApp booking flow", "3,900+ reservations · 85% conversion"],
  },
  {
    company: "UII Informatics Laboratory",
    period: "Sep 2023 — Jan 2026",
    role: "Laboratory Assistant",
    summary: "Teaching and mentoring across programming, web development, algorithms, and computer systems.",
    details: ["Mentored 150+ students", "Hands-on debugging", "Technical assignment guidance", "Practical explanations for complex topics"],
  },
  {
    company: "Savebite",
    period: "Aug 2024 — Jan 2025",
    role: "Full Stack Mobile Developer",
    summary: "Backend services and Android features for a food-tech mobile application.",
    details: ["REST APIs with Express", "Relational database design", "Jetpack Compose features"],
  },
  {
    company: "TEDxUII",
    period: "May 2024 — Jun 2024",
    role: "Backend Developer",
    summary: "Production backend for a web-based ticketing system.",
    details: ["Express.js APIs", "PostgreSQL and Redis", "VPS deployment"],
  },
];
---

<div class="experience-section">
  <div class="experience-inner">
    <header class="section-heading">
      <p class="section-index">04 / Experience</p>
      <h2>From the lab to <em>production.</em></h2>
      <p>A track record across product teams, research, education, and systems serving real users.</p>
    </header>

    <div class="experience-list">
      {experiences.map((item, index) => (
        <details class="experience-row" open={index === 0}>
          <summary>
            <span class="row-number">0{index + 1}</span>
            <span class="company">{item.company}</span>
            <span class="role">{item.role}</span>
            <span class="period">{item.period}</span>
            <span class="toggle" aria-hidden="true"></span>
          </summary>
          <div class="row-content">
            <p>{item.summary}</p>
            <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>
          </div>
        </details>
      ))}
    </div>
  </div>
</div>

<style>
  .experience-section {
    padding: clamp(5rem, 10vw, 9rem) 1.5rem;
    background: var(--paper-light);
  }

  .experience-inner {
    max-width: 1380px;
    margin: 0 auto;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) 1.1fr 0.55fr;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .section-index {
    margin: 0;
    align-self: start;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--text-muted));
  }

  h2 {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(3rem, 6.5vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  h2 em {
    color: var(--signal);
    font-weight: 400;
  }

  .section-heading > p:last-child {
    margin: 0;
    color: rgb(var(--text-muted));
    line-height: 1.6;
  }

  .experience-list {
    border-top: 1px solid var(--ink);
  }

  .experience-row {
    border-bottom: 1px solid var(--ink);
  }

  summary {
    display: grid;
    grid-template-columns: 3rem minmax(150px, 0.7fr) minmax(220px, 1fr) minmax(130px, auto) 1.5rem;
    gap: 1rem;
    align-items: center;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    transition: color 180ms ease, padding 180ms ease;
  }

  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--signal); padding-left: 0.5rem; }

  .row-number,
  .period {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: rgb(var(--text-muted));
    text-transform: uppercase;
  }

  .company {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .role {
    font-size: 0.95rem;
  }

  .period { text-align: right; }

  .toggle {
    position: relative;
    width: 1rem;
    height: 1rem;
  }

  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .toggle::after {
    transform: rotate(90deg);
    transition: transform 180ms ease;
  }

  details[open] .toggle::after { transform: rotate(0deg); }

  .row-content {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) 1fr;
    gap: 2rem;
    margin-left: calc(3rem + 1rem);
    padding: 0 2.5rem 2rem 0;
  }

  .row-content p {
    margin: 0;
    max-width: 31rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .row-content ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.45rem;
  }

  .row-content li {
    position: relative;
    padding-left: 1rem;
    color: rgb(var(--text-muted));
    font-size: 0.88rem;
  }

  .row-content li::before {
    content: "↳";
    position: absolute;
    left: 0;
    color: var(--signal);
  }

  @media (max-width: 820px) {
    .section-heading { grid-template-columns: 1fr; }
    summary { grid-template-columns: 2rem 1fr 1.5rem; }
    .role { grid-column: 2; }
    .period { grid-column: 2; text-align: left; }
    .toggle { grid-column: 3; grid-row: 1; }
    .row-content { grid-template-columns: 1fr; margin-left: 3rem; }
  }

  @media (max-width: 620px) {
    .experience-section { padding-inline: 1rem; }
  }
</style>
