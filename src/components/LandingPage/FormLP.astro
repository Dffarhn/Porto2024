---
const socialLinks = [
  { href: "https://github.com/Dffarhn", label: "GitHub" },
  { href: "https://linkedin.com/in/dapdap", label: "LinkedIn" },
  { href: "https://instagram.com/dffar.hn", label: "Instagram" },
];
---

<footer class="contact-section">
  <div class="contact-inner">
    <div class="contact-top">
      <p class="section-index">07 / Start a conversation</p>
      <p class="availability"><span></span> Open to opportunities</p>
    </div>

    <h2>Have a difficult problem?<br /><a href="https://linkedin.com/in/dapdap" target="_blank" rel="noopener noreferrer">Let’s build through it. <span>↗</span></a></h2>

    <div class="contact-bottom">
      <p>Full-stack engineering · Backend systems · Applied AI · Research</p>
      <nav aria-label="Social links">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
        ))}
      </nav>
      <p class="copyright">© {new Date().getFullYear()} Daffa Raihan</p>
    </div>
  </div>
</footer>

<style>
  .contact-section {
    padding: clamp(5rem, 10vw, 9rem) 1.5rem 2rem;
    background: var(--dark-surface);
    color: var(--on-dark);
  }

  .contact-inner {
    max-width: 1380px;
    margin: 0 auto;
  }

  .contact-top,
  .contact-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(242, 240, 232, 0.3);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .contact-top p,
  .contact-bottom p { margin: 0; }

  .availability {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .availability span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acid);
  }

  h2 {
    margin: clamp(4rem, 10vw, 9rem) 0;
    color: var(--on-dark);
    font-size: clamp(3rem, 7vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.95;
  }

  h2 a {
    display: inline-flex;
    gap: 1rem;
    color: var(--acid);
    border-bottom: 0.06em solid var(--acid);
  }

  h2 a:hover {
    color: var(--on-dark);
    border-color: var(--on-dark);
  }

  h2 span { font-size: 0.45em; }

  .contact-bottom {
    align-items: center;
    border-bottom: 1px solid rgba(242, 240, 232, 0.3);
  }

  .contact-bottom nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .contact-bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgba(242, 240, 232, 0.35);
    border-radius: 999px;
    color: var(--on-dark);
    font-size: 0.78rem;
  }
  .contact-bottom a:hover { color: var(--acid); }

  @media (max-width: 760px) {
    .contact-section { padding-inline: 1rem; }
    .contact-bottom { align-items: flex-start; flex-direction: column; }
    .contact-bottom nav { justify-content: flex-start; }
  }
</style>
