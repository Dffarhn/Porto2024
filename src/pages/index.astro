---
import Navbar from "../components/LandingPage/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import Greeting from "../components/LandingPage/Greeting.astro";
import CardProject from "@/components/LandingPage/CardProject.astro";
import FormLP from "@/components/LandingPage/FormLP.astro";
import AboutPage from "@/components/LandingPage/AboutPage.astro";
import Achievements from "@/components/LandingPage/Achievements.astro";
import WorkExperience from "@/components/LandingPage/WorkExperience.astro";
import Education from "@/components/LandingPage/Education.astro";
import { featuredProjects } from "@/data/projects";

const navLinks = [
  { href: "#projects", text: "Work" },
  { href: "#about", text: "Profile" },
  { href: "#work-experience", text: "Experience" },
  { href: "#contact", text: "Contact" },
];

const siteURL = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const jsonLdExtra = [
  {
    "@type": "ItemList",
    name: "Selected projects",
    itemListElement: featuredProjects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${siteURL}/projects/${project.slug}`,
      name: project.title,
    })),
  },
];
---

<Layout
  jsonLdExtra={jsonLdExtra}
  title="Daffa Raihan | Full-stack Developer (UII) Portfolio"
  description="Daffa Raihan is a full-stack developer at UII building production web, mobile, and backend systems with Golang, NestJS, Next.js, Laravel, and Flutter, plus applied AI with Claude and Hermes. Explore projects, experience, awards, and education."
  keywords="daffa raihan, daffaraihan, daffa raihan portfolio, daffa raihan uii, universitas islam indonesia, uii informatics, full stack developer, full stack engineer, software engineer, backend engineer, nestjs developer, golang developer, next.js developer, laravel developer, php developer, flutter developer, postgresql, mysql, ci/cd, ai agents, claude, hermes agent, system design, indes 2025, automata 2025, explainable ai, xai"
>
  <Navbar navigasi={navLinks} />

  <section id="greeting">
    <Greeting />
  </section>
  
  <section id="about">
    <AboutPage />
  </section>

  <section class="overflow-hidden" id="projects">
    <!-- Project cards + 1 Coffee 1 Web series -->
    <CardProject />
  </section>
  
  <section id="work-experience">
    <WorkExperience />
  </section>
  
  <section id="achievements">
    <Achievements />
  </section>
  
  <section id="education">
    <Education />
  </section>
  
  <section id="contact">
    <FormLP />
  </section>


  <a
    id="scrollToTop"
    href="#greeting"
    class="fixed bottom-5 right-5 z-[9999] bg-[#161713] text-white p-3 rounded-full border border-black/10 hover:bg-[#3157ff] focus:outline-none focus:ring-2 focus:ring-[#3157ff]/30 transition-all duration-300 isolate opacity-0 translate-y-3 pointer-events-none"
    aria-label="Scroll to top"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-6 w-6 mx-auto">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
    </svg>
  </a>
</Layout>

<script>
  const scrollTopButton = document.getElementById("scrollToTop");

  // Fade the scroll-to-top button in and out based on scroll position
  function syncScrollTopButton() {
    if (!scrollTopButton) return;
    const show = window.scrollY > 300;
    scrollTopButton.classList.toggle("opacity-0", !show);
    scrollTopButton.classList.toggle("translate-y-3", !show);
    scrollTopButton.classList.toggle("pointer-events-none", !show);
  }
  window.addEventListener("scroll", syncScrollTopButton, { passive: true });
  syncScrollTopButton();

  // Scroll to the top of the page when the button is clicked
  scrollTopButton?.addEventListener("click", (event) => {
    event.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
